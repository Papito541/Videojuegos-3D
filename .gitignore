# ===================================
# Unity - Carpetas a ignorar
# ===================================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
MemoryCaptures/
UserSettings/

# Evitar archivos del cache y temporales de Addressables y Visual Scripting
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/Unity.VisualScripting.Generated/

# ===================================
# IDEs y archivos de proyecto locales
# ===================================
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.asset

# Unity generated meta files innecesarios
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ===================================
# Exportaciones (Builds)
# ===================================
*.apk
*.aab
*.unitypackage
*.app
*.exe

# ===================================
# Crashlytics
# ===================================
crashlytics-build.properties

# ===================================
# Sistema Operativo
# ===================================
# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store
._*

# Linux
*~

# ===================================
# Archivos grandes (opcional: Git LFS)
# ===================================
